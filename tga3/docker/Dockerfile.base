# Tool baseline: StrikeAgent TSecBench Dockerfile at
# https://github.com/Yean-Sec/StrikeAgent_AtkBrain-Flash/blob/7526baa7ea88de04b1900f04a06b13b77ab5682e/Dockerfile
ARG PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337
FROM ${PYTHON_IMAGE}

ARG DEBIAN_MIRROR=mirrors.aliyun.com
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
    NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

# Match upstream required packages. ripgrep supports native CLI file search.
# Keep transport retries bounded and TLS verification on.
RUN set -eu; \
    if [ -n "${DEBIAN_MIRROR}" ]; then \
      for source in /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list; do \
        if [ -f "$source" ]; then \
          sed -i "s|deb.debian.org|${DEBIAN_MIRROR}|g; s|security.debian.org|${DEBIAN_MIRROR}|g" "$source"; \
        fi; \
      done; \
    fi; \
    printf '%s\n' 'Acquire::Retries "3";' 'Acquire::http::Timeout "60";' \
      'Acquire::https::Timeout "60";' > /etc/apt/apt.conf.d/80-tga3-network; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      ca-certificates curl wget git jq vim-tiny less procps iproute2 iputils-ping \
      gcc g++ make nasm pkg-config libffi-dev libssl-dev \
      unzip p7zip-full xz-utils file bsdmainutils xxd binutils elfutils \
      strace ltrace tmux openssl nmap socat netcat-traditional gdb php-cli ruby \
      default-mysql-client redis-tools postgresql-client smbclient \
      libimage-exiftool-perl ripgrep; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

# Match StrikeAgent optional packages and its skip-on-unavailable policy.
# Persist outcomes so verification exposes absent optional scanners.
RUN set -eu; \
    mkdir -p /opt/tga3; \
    : > /opt/tga3/tool-install-status.tsv; \
    apt-get update; \
    for package in \
      ncat gdbserver sqlmap nikto gobuster dirb wfuzz hydra john \
      radare2 binwalk sslscan foremost steghide python3-impacket \
      python3-pycryptodome python3-sympy python3-bs4 python3-pil \
      ffuf feroxbuster masscan whatweb wafw00f hashid enum4linux tshark checksec; do \
      if apt-get install -y --no-install-recommends "$package"; then \
        printf '%s\tinstalled\n' "$package" >> /opt/tga3/tool-install-status.tsv; \
      else \
        printf '%s\tunavailable\n' "$package" >> /opt/tga3/tool-install-status.tsv; \
        echo "[tga3] optional package unavailable: $package"; \
      fi; \
    done; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

COPY docker/ctf-python-requirements.txt /opt/tga3/ctf-python-requirements.txt
ENV PATH="/opt/tga3-venv/bin:${PATH}"
RUN python3 -m venv /opt/tga3-venv \
    && pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir -r /opt/tga3/ctf-python-requirements.txt

ARG TGA3_WORKER_UID=1000
ARG TGA3_WORKER_GID=1000
RUN groupadd --gid "${TGA3_WORKER_GID}" tga3 \
    && useradd --uid "${TGA3_WORKER_UID}" --gid "${TGA3_WORKER_GID}" --create-home --shell /bin/bash tga3 \
    && install -d -o "${TGA3_WORKER_UID}" -g "${TGA3_WORKER_GID}" \
       /workspace /logs /findings /home/tga3/.cache

ENV HOME=/home/tga3
WORKDIR /workspace
