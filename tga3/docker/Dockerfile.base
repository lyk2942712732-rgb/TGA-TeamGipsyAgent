FROM kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# kali-linux-headless is the official non-GUI metapackage. It gives both workers
# the same broad CTF tool floor without carrying a desktop image.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       kali-linux-headless \
       python3 \
       python3-pip \
       python3-venv \
       ca-certificates \
       git \
       curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/tga3-venv
ENV PATH="/opt/tga3-venv/bin:${PATH}"
WORKDIR /workspace
