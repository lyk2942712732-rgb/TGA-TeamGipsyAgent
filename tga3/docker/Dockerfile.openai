ARG CLI_BASE_IMAGE=tga3-cli-base:local
FROM ${CLI_BASE_IMAGE}

USER root
ARG CLI_VERSION=0.158.0
RUN npm install -g @openai/codex@${CLI_VERSION} && npm cache clean --force
COPY pyproject.toml README.md /opt/tga3/
COPY src /opt/tga3/src
RUN pip install --no-cache-dir /opt/tga3

USER tga3:tga3
ENTRYPOINT ["python", "-m", "tga3.workers.openai_worker"]
