{
  "schema_version": 1,
  "postgres_dsn": "postgresql://tga3:tga3@127.0.0.1:5433/tga3",
  "control_ws_url": "ws://host.docker.internal:8083/internal/agents",
  "blackboard_mcp_url": "http://host.docker.internal:8083/mcp",
  "listen_host": "0.0.0.0",
  "listen_port": 8083,
  "workspace_root": "./data/workspaces",
  "input_root": "./data/inputs",
  "artifact_root": "./data/artifacts",
  "writeup_root": "./data/writeups",
  "skills_root": "./config/skills",
  "mcp_instructions": "黑板 MCP 提供黑板增量同步、结构化发布和证据登记。Worker 将证据保存到各自私有的 /artifacts，再登记后引用；技能资料通过 CLI 原生文件工具读取 /skills。",
  "worker_images": {
    "worker-openai": "tga3-worker-openai:local",
    "worker-claude": "tga3-worker-claude:local",
    "reporter": "tga3-worker-openai:local"
  },
  "worker_cycle_prompts": {
    "startup": "开始任务：先读取完整共享黑板中的场景提示、用户描述和文件，记住最新序号，再自主推进。",
    "periodic": "进入周期工作：先增量读取共享黑板，再从当前会话状态继续推进任务。",
    "blackboard_changed": "共享黑板已更新且同一工作阶段的通知已合并。请在本周期开始时读取你记住的上次序号之后的全部条目，处理到 latest_seq={latest_seq} 后再继续；不要重新读取完整黑板。"
  },
  "docker": {
    "network": "bridge",
    "cpu_cores": 2.0,
    "memory_mb": 4096,
    "pids_limit": 512,
    "cap_add": [
      "NET_RAW",
      "SYS_PTRACE"
    ]
  },
  "cadence": {
    "worker_sync_seconds": 90,
    "finalization_grace_seconds": 30
  },
  "cli_timeout_seconds": 1800
}
