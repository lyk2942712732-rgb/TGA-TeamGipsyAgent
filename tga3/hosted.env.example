# The platform injects BENCHMARK_TOKEN and BENCHMARK_BASE_URL automatically.
# Configure these model settings in its runtime-environment-variable form.
# Provider must appear in the TSec gateway allowlist and support the required API.
CODEX_BASE_URL=https://YOUR-APPROVED-PROVIDER/compatible-mode/v1
CODEX_MODEL=YOUR-RESPONSES-MODEL
CODEX_API_KEY=YOUR-KEY
CLAUDE_BASE_URL=https://YOUR-APPROVED-PROVIDER/apps/anthropic
CLAUDE_MODEL=YOUR-ANTHROPIC-MODEL
CLAUDE_API_KEY=YOUR-KEY
# OpenCode/Qwen default to the same Anthropic settings as Claude Code.
# Optional: OPENCODE_* / QWEN_* override BASE_URL, MODEL, API_KEY individually.
# OPENCODE_PROTOCOL=anthropic
# QWEN_PROTOCOL=anthropic
# When selecting openai_chat_completions, also set CHAT_BASE_URL/MODEL/API_KEY.
AOE_FIRST_MINUTES=30
AOE_SECOND_MINUTES=15
AOE_JOINT_MINUTES=20
BENCHMARK_INSTANCE_QUOTA=3
