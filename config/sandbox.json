{
  "version": 1,
  "runtime": "disabled",
  "terminal_grace_seconds": 900,
  "reconcile_interval_seconds": 60,
  "docker_sandbox": {
    "executable": "sbx",
    "task_root": "runs",
    "template": "docker.io/docker/sandbox-templates:shell-docker@sha256:REPLACE_WITH_RELEASE_DIGEST",
    "min_version": "0.34.0",
    "max_version_exclusive": "0.35.0"
  },
  "sandboxd": {
    "socket_path": "/run/tga-sandboxd/sandboxd.sock",
    "rpc_timeout_seconds": 10,
    "protocol_major": 1,
    "run_root": "/var/lib/tga/runs",
    "allowed_client_uids": []
  },
  "tools": {},
  "profiles": {
    "default-kali": {
      "id": "default-kali",
      "provider": "sandboxd",
      "image": "ghcr.io/team-gipsy/tga-kali-default@sha256:REPLACE_WITH_RELEASE_DIGEST",
      "network_mode": "target_allowlist",
      "allow_net_raw": false,
      "limits": {
        "timeout_seconds": 600,
        "max_output_bytes": 262144,
        "memory_bytes": 1073741824,
        "cpu_count": 2.0,
        "pids_limit": 512
      }
    },
    "remote-http": {
      "id": "remote-http",
      "provider": "remote_http",
      "network_mode": "remote"
    }
  }
}
