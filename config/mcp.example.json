{
  "version": 2,
  "maxConcurrency": 4,
  "servers": {
    "remote-scanner": {
      "enabled": false,
      "transport": "streamable_http",
      "http": {
        "url": "https://mcp.example.com/mcp",
        "verifyTls": true,
        "headers": {
          "X-Client": "tga"
        },
        "secretRefs": {
          "Authorization": "env:MCP_SCANNER_TOKEN"
        },
        "proxyUrl": null,
        "allowSameOriginRedirects": false
      },
      "enabledTools": []
    }
  }
}
