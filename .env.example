# TGA2 local configuration. Never commit real credentials.
TGA2_RUN_ROOT=runs2
TGA2_WEB_ROOT=apps/web/dist

# Providers, model API keys and Solver model assignments are configured through
# runs2/.config/models.json and runs2/.config/runtime.json only.

# Vite development only. Production uses the same FastAPI origin.
VITE_TGA_API_BASE=http://127.0.0.1:8000
