# TGA environment example.
# Do not commit real secrets.

# The single run root. Every task, database, artifact and sandbox lifecycle
# resolves through this; nothing may hardcode "runs". Packaged installs use
# /var/lib/tga/runs.
TGA_RUN_ROOT=runs
# Prebuilt frontend bundle. Production never builds at startup; point this at
# the packaged bundle (e.g. /opt/tga/web). Unset falls back to apps/web/dist.
TGA_WEB_DIST=
# Deployment state and component logs. Default to siblings of the run root.
TGA_STATE_DIR=
TGA_LOG_DIR=
# Root-owned sandbox policy, and an optional runtime override.
TGA_SANDBOX_CONFIG_PATH=config/sandbox.json
# TGA_SANDBOX_RUNTIME=enforced
# Explicit MCP allowlist. Defaults to config/mcp.json (empty server set).
TGA_MCP_CONFIG_PATH=config/mcp.json
TGA_MCP_IMPORT_MAX_BYTES=2147483648

# OpenAI-compatible provider. Secrets are process environment only.
TGA_LLM_API_KEY=
TGA_LLM_BASE_URL=
TGA_LLM_MODEL=
TGA_LLM_TIMEOUT_S=60
TGA_LLM_MAX_OUTPUT_TOKENS=512
TGA_LLM_TEMPERATURE=0.2
TGA_LLM_SUPPORTS_VISION=
# Optional browser-managed settings path. Defaults to ~/.tga/llm-settings.json.
TGA_LLM_CONFIG_PATH=

# Frontend. Empty means same-origin /api; local dev can use http://127.0.0.1:8000.
VITE_TGA_API_BASE=http://127.0.0.1:8000
# Phase-10 task-level workbench is the default. Set to legacy for temporary UI rollback.
